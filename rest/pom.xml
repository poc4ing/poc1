<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>es.kyoe.ing.poc1</groupId>
        <artifactId>kyoe-ing-mortgage-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <properties>
        <graalvm.version>24.1.0</graalvm.version>
    </properties>
    <artifactId>kyoe-ing-mortgage-rest</artifactId>

    <dependencies>

        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>swagger-ui</artifactId>
            <version>5.32.0</version>
        </dependency>

        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${org.mapstruct.version}</version>
        </dependency>

        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
            <version>${org.mapstruct.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>es.kyoe.ing.poc1</groupId>
            <artifactId>kyoe-ing-mortgage-api</artifactId>
        </dependency>

        <dependency>
            <groupId>es.kyoe.ing.poc1</groupId>
            <artifactId>kyoe-ing-mortgage-application</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.graphql-java-generator</groupId>
                    <artifactId>graphql-java-client-runtime</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.openapitools</groupId>
            <artifactId>jackson-databind-nullable</artifactId>
            <version>0.2.1</version>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>3.0.2</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-xml</artifactId>
        </dependency>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
            <version>2.2.39</version>
        </dependency>

        <dependency>
            <groupId>org.graalvm.sdk</groupId>
            <artifactId>graal-sdk</artifactId>
            <version>${graalvm.version}</version>
        </dependency>

        <dependency>
            <groupId>org.graalvm.truffle</groupId>
            <artifactId>truffle-api</artifactId>
            <version>${graalvm.version}</version>
        </dependency>

        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-core-jakarta</artifactId>
            <version>2.2.39</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.9</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.intuit.karate</groupId>
            <artifactId>karate-junit5</artifactId>
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-dynatrace</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>send-empty-bucket-server</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>es.kyoe.ing.poc1</groupId>
                                    <artifactId>kyoe-ing-mortgage-api</artifactId>
                                    <version>${project.version}</version>
                                    <outputDirectory>${project.build.directory}/openapi</outputDirectory>
                                    <includes>openapi.yml,schemas/**</includes>
                                    <overWrite>true</overWrite>
                                </artifactItem>
                            </artifactItems>
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>7.8.0</version>
                <executions>
                    <execution>
                        <id>generate-server-spring</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.build.directory}/openapi/openapi.yml</inputSpec>
                            <generatorName>spring</generatorName>
                            <library>spring-boot</library>
                            <strictSpec>true</strictSpec>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <configOptions>
                                <packageName>es.kyoe.ing.mortgage.web.infrastructure.rest</packageName>
                                <modelPackage>es.kyoe.ing.mortgage.web.infrastructure.rest.model</modelPackage>
                                <apiPackage>es.kyoe.ing.mortgage.web.infrastructure.rest.api</apiPackage>
                                <interfaceOnly>true</interfaceOnly>
                                <skipDefaultInterface>true</skipDefaultInterface>
                                <useTags>true</useTags>
                                <useBuilder>true</useBuilder>
                                <generateConstructor>true</generateConstructor>
                                <useJakartaEe>true</useJakartaEe>
                                <useSpringBoot3>true</useSpringBoot3>
                                <dateLibrary>java8</dateLibrary>
                            </configOptions>
                            <typeMappings>
                                <typeMapping>OffsetDateTime=String</typeMapping>
                                <typeMapping>float=Double</typeMapping>
                            </typeMappings>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin}</version>
                <configuration>
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>local</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>es.kyoe.ing.poc1</groupId>
                    <artifactId>kyoe-ing-mortgage-h2</artifactId>
                </dependency>
            </dependencies>
            <build>
                <finalName>${project.name}-local</finalName>
            </build>
        </profile>
        <profile>
            <id>dev</id>
            <dependencies>
                <dependency>
                    <groupId>es.kyoe.ing.poc1</groupId>
                    <artifactId>kyoe-ing-mortgage-h2</artifactId>
                </dependency>
            </dependencies>
            <build>
                <finalName>${project.name}-dev</finalName>
            </build>
        </profile>
        <profile>
            <id>int</id>
            <dependencies>
                <dependency>
                    <groupId>es.kyoe.ing.poc1</groupId>
                    <artifactId>kyoe-ing-mortgage-h2</artifactId>
                </dependency>
            </dependencies>
            <build>
                <finalName>${project.name}-int</finalName>
            </build>
        </profile>
        <profile>
            <id>pro</id>
            <dependencies>
                <dependency>
                    <groupId>es.kyoe.ing.poc1</groupId>
                    <artifactId>kyoe-ing-mortgage-h2</artifactId>
                </dependency>
            </dependencies>
            <build>
                <finalName>${project.name}-pro</finalName>
            </build>
        </profile>
        <profile>
            <id>persistency-mock</id>
            <dependencies>
                <dependency>
                    <groupId>es.kyoe.ing.poc1</groupId>
                    <artifactId>kyoe-ing-mortgage-persistency-mock</artifactId>
                </dependency>
            </dependencies>
            <build>
                <finalName>${project.name}-persistency-mock</finalName>
            </build>
        </profile>
        <profile>
            <id>h2-persistency</id>
            <dependencies>
                <dependency>
                    <groupId>es.kyoe.ing.poc1</groupId>
                    <artifactId>kyoe-ing-mortgage-h2</artifactId>
                </dependency>
            </dependencies>
            <build>
                <finalName>${project.name}-h2-persistency</finalName>
            </build>
        </profile>
        <profile>
            <id>with-testing</id>
            <dependencies>
                <dependency>
                    <groupId>es.kyoe.ing.poc1</groupId>
                    <artifactId>kyoe-ing-mortgage-h2</artifactId>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
